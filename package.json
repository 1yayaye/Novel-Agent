{
  "name": "novel-agent",
  "version": "0.1.0",
  "description": "Local-first novel writing workbench",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm winui:dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude .agents/**",
    "build": "node scripts/build.mjs",
    "probe:native": "pnpm build && node scripts/run-native-probe.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm probe:native && pnpm winui:package",
    "winui:build": "dotnet build src-winui/NovelAgent.WinUI.csproj -p:Platform=x64 -c Debug",
    "winui:build:release": "dotnet build src-winui/NovelAgent.WinUI.csproj -p:Platform=x64 -c Release",
    "winui:run": "dotnet run --project src-winui/NovelAgent.WinUI.csproj -p:Platform=x64",
    "winui:dev": "node scripts/run-winui-dev.mjs",
    "winui:package": "node scripts/package-winui.mjs"
  },
  "dependencies": {
    "@primno/dpapi": "^2.0.1",
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@appica/ui-react": "^1.1.0",
    "@codemirror/commands": "6.11.0",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.17.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  }
}
